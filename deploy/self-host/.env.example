# Liste self-host configuration. Copy to .env and fill in the values.
# Configuration is environment variables only; there is no config file.

# --- Required ---

# PostgreSQL connection string for the sync server.
DATABASE_URL=postgres://liste:change-me@postgres:5432/liste

# Password for the bundled postgres service (must match DATABASE_URL).
POSTGRES_PASSWORD=change-me

# Public base URL of this instance as seen by clients, including scheme.
LISTE_PUBLIC_URL=https://liste.example.com

# Address the server listens on inside the container.
LISTE_BIND_ADDR=0.0.0.0:8080

# Run pending migrations on start. Default for self-hosting.
LISTE_AUTO_MIGRATE=true

# --- Email (one-time sign-in codes) ---

# Transactional email provider: postmark or resend.
LISTE_EMAIL_PROVIDER=postmark
LISTE_EMAIL_API_KEY=
LISTE_EMAIL_FROM=Liste <no-reply@liste.example.com>

# --- Optional ---

# Push relay run by Liste Cloud. Leave empty to fall back to polling.
LISTE_PUSH_RELAY_URL=
LISTE_PUSH_RELAY_TOKEN=

# S3-compatible storage for attachments (when attachments ship).
LISTE_S3_ENDPOINT=
LISTE_S3_BUCKET=
LISTE_S3_ACCESS_KEY_ID=
LISTE_S3_SECRET_ACCESS_KEY=

# Server URL the web app shell points at. Usually the same as LISTE_PUBLIC_URL.
LISTE_WEB_SERVER_URL=https://liste.example.com
